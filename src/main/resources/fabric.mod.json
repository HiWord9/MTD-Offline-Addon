{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issue_tracker}"
  },

  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "${mod_main_dir}.${mod_client_class}::INSTANCE"
    ],
    "modmenu": [
      "${mod_main_dir}.config.ModMenuIntegration::INSTANCE"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],

  "depends": {
    "my-totem-doll": "*",
    "fabricloader": "${loader_version_range}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}"
  }
}
